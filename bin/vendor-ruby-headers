#!/usr/bin/env ruby
# frozen_string_literal: true

# Copies the internal headers the tracer compiles against out of a Ruby
# source tree, for the Ruby running this script:
#
#   bin/vendor-ruby-headers ~/src/ruby-4.0.7
#
# The source has to be the exact version, which is checked against the
# running Ruby's revision.

require "fileutils"
require "rbconfig"
require "tmpdir"

source = File.expand_path(ARGV.fetch(0) { abort "usage: #{$PROGRAM_NAME} RUBY_SOURCE_DIR" })
revision = File.read(File.join(source, "revision.h"))[/RUBY_REVISION "([0-9a-f]+)"/, 1]
abort "#{source} is #{revision}, this Ruby is #{RUBY_REVISION}" unless revision && RUBY_REVISION.start_with?(revision)

ext = File.expand_path("../ext/riptide", __dir__)
target = File.join(ext, "ruby", RUBY_VERSION)
config = RbConfig::CONFIG

Dir.mktmpdir do |generated|
  # A release tarball ships the dtrace probes stubbed out, under another name.
  FileUtils.cp(File.join(source, "probes.dmyh"), File.join(generated, "probes.h")) unless File.exist?(File.join(source, "probes.h"))
  deps = IO.popen([config["CC"], "-M", "-I#{config["rubyarchhdrdir"]}", "-I#{config["rubyhdrdir"]}", "-I#{generated}", "-I#{source}",
                   File.join(ext, "riptide_native.c")], &:read)
  abort "couldn't list the tracer's headers" unless $?.success?

  FileUtils.rm_rf(target)
  deps.split(/\s+/).reject { |word| word.end_with?(":") || word == "\\" }.each do |path|
    path = File.expand_path(path)
    from = [source, generated].find { |dir| path.start_with?("#{dir}/") }
    next unless from

    relative = path.delete_prefix("#{from}/")
    FileUtils.mkdir_p(File.join(target, File.dirname(relative)))
    FileUtils.cp(path, File.join(target, relative))
  end
end
File.write(File.join(target, "REVISION"), "#{revision}\n")
puts "#{target}: #{Dir.glob("**/*", base: target).count { |f| File.file?(File.join(target, f)) }} files"
